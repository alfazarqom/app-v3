{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alfazarqom/app-v3/schemas/mock-user.schema.json",
  "title": "Travel & Tours Mock Users",
  "type": "object",
  "required": [
    "users",
    "fixtureMetadata"
  ],
  "properties": {
    "fixtureMetadata": {
      "type": "object",
      "required": [
        "classification",
        "notForProduction",
        "passwordStorage",
        "warning"
      ],
      "properties": {
        "classification": {
          "const": "mock-only"
        },
        "notForProduction": {
          "const": true
        },
        "passwordStorage": {
          "const": "plaintext-test-fixture-only"
        },
        "warning": {
          "type": "string",
          "minLength": 1
        },
        "productionUsage": {
          "const": "prohibited"
        },
        "credentialUsage": {
          "const": "fixture-only"
        }
      },
      "additionalProperties": false
    },
    "users": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "phone",
          "role",
          "authProvider",
          "isGuest",
          "credentials",
          "status",
          "preferences",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\+[1-9][0-9]{7,14}$"
          },
          "authProvider": {
            "enum": [
              "guest",
              "phone"
            ]
          },
          "isGuest": {
            "type": "boolean"
          },
          "credentials": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "password": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "active",
              "inactive",
              "suspended"
            ]
          },
          "preferences": {
            "type": "object",
            "required": [
              "language",
              "currency",
              "notifications"
            ],
            "additionalProperties": false,
            "properties": {
              "language": {
                "type": "string",
                "minLength": 2
              },
              "currency": {
                "enum": [
                  "IDR",
                  "USD",
                  "GBP"
                ]
              },
              "notifications": {
                "type": "object",
                "required": [
                  "email",
                  "push"
                ],
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "type": "boolean"
                  },
                  "push": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "createdAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          },
          "updatedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          },
          "role": {
            "enum": [
              "guest",
              "customer"
            ]
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "isGuest": {
                  "const": true
                }
              },
              "required": [
                "isGuest"
              ]
            },
            "then": {
              "properties": {
                "authProvider": {
                  "const": "guest"
                },
                "credentials": {
                  "type": "null"
                },
                "phone": {
                  "type": "null"
                },
                "role": {
                  "const": "guest"
                }
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "isGuest": {
                  "const": false
                }
              },
              "required": [
                "isGuest"
              ]
            },
            "then": {
              "properties": {
                "authProvider": {
                  "const": "phone"
                },
                "phone": {
                  "type": "string",
                  "pattern": "^\\+[1-9][0-9]{7,14}$"
                },
                "credentials": {
                  "type": "object",
                  "required": [
                    "password"
                  ],
                  "properties": {
                    "password": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "role": {
                  "const": "customer"
                }
              },
              "additionalProperties": false
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
