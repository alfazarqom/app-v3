{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alfazarqom/app-v3/schemas/blueprint.schema.json",
  "title": "Travel & Tours Application Blueprint",
  "type": "object",
  "required": [
    "blueprint",
    "App",
    "AuthScreen",
    "AppShell",
    "StandalonePages",
    "Routing",
    "Navigation",
    "Overlays",
    "DesignSystem",
    "TechnicalStandards",
    "Requirements",
    "Scope",
    "ComponentRegistry",
    "Repository"
  ],
  "properties": {
    "blueprint": {
      "type": "object",
      "required": [
        "name",
        "version",
        "status",
        "platform",
        "orientation",
        "framework",
        "language",
        "revision",
        "previousRevision"
      ],
      "properties": {
        "name": {
          "const": "Travel & Tours"
        },
        "version": {
          "const": "1.4.0"
        },
        "status": {
          "type": "string"
        },
        "platform": {
          "const": "mobile-only"
        },
        "orientation": {
          "const": "portrait"
        },
        "framework": {
          "const": "React"
        },
        "language": {
          "const": "TypeScript"
        },
        "revision": {
          "const": "1.4.0"
        },
        "previousRevision": {
          "const": "1.3.0"
        },
        "source": {
          "type": "string",
          "const": "blueprint.json"
        },
        "documentType": {
          "type": "string",
          "const": "application-specific-blueprint"
        },
        "validationStatus": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "App": {
      "type": "object",
      "required": [
        "component",
        "guestAccess",
        "layoutSelection"
      ],
      "properties": {
        "component": {
          "const": "App"
        },
        "guestAccess": {
          "type": "object",
          "required": [
            "enabled",
            "allowedAccessLevels",
            "accessPolicy"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "allowedAccessLevels": {
              "const": [
                "public",
                "guest-allowed"
              ]
            },
            "accessPolicy": {
              "const": "public-and-guest-allowed-routes-only"
            },
            "action": {
              "const": "ContinueAsGuest"
            },
            "destination": {
              "const": "AppShell"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "Routing": {
      "type": "object",
      "required": [
        "accessPolicy",
        "fallback",
        "entryRoute"
      ],
      "properties": {
        "accessPolicy": {
          "type": "object",
          "required": [
            "allowedValues",
            "guest",
            "routeDeclaration"
          ],
          "properties": {
            "allowedValues": {
              "const": [
                "public",
                "guest-allowed",
                "authenticated"
              ]
            },
            "guest": {
              "const": "public-and-guest-allowed-routes-only"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "Requirements": {
      "type": "object",
      "required": [
        "baseline",
        "previousBaseline",
        "items"
      ],
      "properties": {
        "baseline": {
          "const": "v1.4.0"
        },
        "previousBaseline": {
          "const": "v1.3.0"
        },
        "items": {
          "type": "array",
          "minItems": 29,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "acceptanceCriteria"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^F-[0-9]{2}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "acceptanceCriteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "priority": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            },
            "additionalProperties": false
          },
          "maxItems": 29
        }
      },
      "additionalProperties": false
    },
    "DesignSystem": {
      "type": "object",
      "required": [
        "layout"
      ],
      "properties": {
        "layout": {
          "type": "object",
          "required": [
            "safeAreaPolicy",
            "bottomNav",
            "standalonePage"
          ],
          "properties": {
            "safeAreaPolicy": {
              "type": "object",
              "required": [
                "owner",
                "applyTo",
                "childComponents",
                "childSafeAreaAwareSemantics",
                "prohibitDuplicateInsets"
              ],
              "properties": {
                "owner": {
                  "const": "application-layout"
                },
                "prohibitDuplicateInsets": {
                  "const": true
                }
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "TechnicalStandards": {
      "type": "object",
      "required": [
        "validation"
      ],
      "properties": {
        "validation": {
          "type": "object",
          "required": [
            "jsonSchema",
            "mockUserSchema",
            "mockProductsSchema",
            "crossReferenceValidation",
            "automatedWorkflow"
          ]
        }
      },
      "additionalProperties": true
    },
    "ComponentRegistry": {
      "type": "object",
      "required": [
        "registeredComponents"
      ],
      "properties": {
        "registeredComponents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Repository": {
      "type": "object",
      "required": [
        "purpose",
        "implementationScope",
        "excludedRuntimeImplementation",
        "mergeApproval",
        "deploymentApproval"
      ],
      "properties": {
        "purpose": {
          "const": "blueprint-and-mock-data-governance"
        },
        "excludedRuntimeImplementation": {
          "const": true
        },
        "mergeApproval": {
          "const": "separate-explicit-approval"
        },
        "deploymentApproval": {
          "const": "separate-explicit-approval"
        },
        "mockCredentialPolicy": {
          "const": "mock-fixtures-never-used-for-production-authentication"
        },
        "implementationScope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "AuthScreen": {
      "type": "object"
    },
    "AppShell": {
      "type": "object"
    },
    "StandalonePages": {
      "type": "object"
    },
    "Navigation": {
      "type": "object"
    },
    "Overlays": {
      "type": "object"
    },
    "Scope": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
