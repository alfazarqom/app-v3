{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alfazarqom/app-v3/schemas/mock-products.schema.json",
  "title": "Travel & Tours Mock Products",
  "type": "object",
  "required": [
    "products",
    "fixtureMetadata"
  ],
  "properties": {
    "fixtureMetadata": {
      "type": "object",
      "required": [
        "classification",
        "notForProduction",
        "imageAssets",
        "warning"
      ],
      "properties": {
        "classification": {
          "const": "mock-only"
        },
        "notForProduction": {
          "const": true
        },
        "imageAssets": {
          "const": "placeholder-only"
        },
        "warning": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "type",
          "category",
          "destination",
          "images",
          "price",
          "duration",
          "rating",
          "availability",
          "inclusions",
          "exclusions",
          "itinerary",
          "tags",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "tour"
          },
          "destination": {
            "type": "object",
            "required": [
              "id",
              "name",
              "country",
              "city"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "country": {
                "type": "string",
                "minLength": 1
              },
              "city": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "price": {
            "type": "object",
            "required": [
              "amount",
              "currency",
              "priceType"
            ],
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "currency": {
                "const": "IDR"
              },
              "priceType": {
                "const": "per_person"
              }
            },
            "additionalProperties": false
          },
          "duration": {
            "type": "object",
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365
              },
              "unit": {
                "enum": [
                  "hours",
                  "days"
                ]
              }
            },
            "additionalProperties": false
          },
          "rating": {
            "type": "object",
            "required": [
              "average",
              "count"
            ],
            "properties": {
              "average": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "availability": {
            "type": "object",
            "required": [
              "status",
              "capacity",
              "remaining"
            ],
            "properties": {
              "status": {
                "enum": [
                  "available",
                  "limited",
                  "sold_out",
                  "unavailable"
                ]
              },
              "capacity": {
                "type": "integer",
                "minimum": 0
              },
              "remaining": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "inclusions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "itinerary": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "day",
                "title",
                "activities"
              ],
              "additionalProperties": false,
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "activities": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          },
          "createdAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          },
          "updatedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "shortDescription": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
