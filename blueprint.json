{
  "App": {
    "name": "Travel & Tours",
    "platform": "Mobile App",
    "layout": "MobileFirst",
    "root": "AppShell",
    "standalonePages": "StandalonePages"
  },
  "AppShell": {
    "component": "AppShell",
    "layout": "vertical",
    "children": [
      {
        "id": "header",
        "component": "Header",
        "position": "top",
        "children": [
          {
            "id": "logo",
            "component": "Logo",
            "action": "NavigateHome"
          },
          {
            "id": "header-actions",
            "component": "HeaderActions",
            "children": [
              {
                "id": "notif-btn",
                "component": "NotifBtn",
                "icon": "bell",
                "action": "NavigateNotificationPage"
              },
              {
                "id": "profile-btn",
                "component": "ProfileBtn",
                "icon": "user-round",
                "action": "NavigateProfilePage"
              }
            ]
          }
        ]
      },
      {
        "id": "content",
        "component": "Content",
        "flex": 1,
        "scrollable": true,
        "children": [
          {
            "id": "home-page",
            "component": "HomePage",
            "route": "/"
          },
          {
            "id": "explore-page",
            "component": "ExplorePage",
            "route": "/explore"
          },
          {
            "id": "livechat-page",
            "component": "LiveChatPage",
            "route": "/live-chat"
          },
          {
            "id": "profile-page",
            "component": "ProfilePage",
            "route": "/profile"
          },
          {
            "id": "notification-page",
            "component": "NotificationPage",
            "route": "/notifications"
          }
        ]
      },
      {
        "id": "bottom-nav",
        "component": "BottomNav",
        "position": "bottom",
        "items": [
          {
            "id": "home",
            "label": "Home",
            "icon": "house",
            "route": "/"
          },
          {
            "id": "explore",
            "label": "Explore",
            "icon": "compass",
            "route": "/explore"
          },
          {
            "id": "livechat",
            "label": "Live Chat",
            "icon": "message-circle",
            "route": "/live-chat"
          }
        ]
      },
      {
        "id": "overlays",
        "component": "Overlays",
        "children": []
      }
    ]
  },
  "StandalonePages": {
    "component": "StandalonePages",
    "layout": {
      "type": "vertical",
      "children": [
        "Header",
        "Content",
        "BottomAction"
      ]
    },
    "pages": [
      {
        "id": "destination-detail-page",
        "component": "DestinationDetailPage",
        "route": "/destinations/:destinationId"
      },
      {
        "id": "tour-detail-page",
        "component": "TourDetailPage",
        "route": "/tours/:tourId"
      },
      {
        "id": "search-results-page",
        "component": "SearchResultsPage",
        "route": "/search"
      },
      {
        "id": "booking-page",
        "component": "BookingPage",
        "route": "/booking"
      },
      {
        "id": "checkout-page",
        "component": "CheckoutPage",
        "route": "/checkout"
      },
      {
        "id": "booking-confirmation-page",
        "component": "BookingConfirmationPage",
        "route": "/booking/confirmation"
      },
      {
        "id": "booking-history-page",
        "component": "BookingHistoryPage",
        "route": "/bookings"
      },
      {
        "id": "booking-detail-page",
        "component": "BookingDetailPage",
        "route": "/bookings/:bookingId"
      }
    ]
  },
  "Navigation": {
    "defaultPage": "HomePage",
    "bottomNavPages": [
      "HomePage",
      "ExplorePage",
      "LiveChatPage"
    ],
    "headerNavigation": {
      "Logo": "HomePage",
      "NotifBtn": "NotificationPage",
      "ProfileBtn": "ProfilePage"
    },
    "standalonePageNavigation": "RouteBased"
  },
  "DesignSystem": {
    "style": "Modern Premium Travel",
    "theme": "Light",
    "layout": {
      "platform": "mobile-only",
      "orientation": "portrait",
      "appShell": {
        "display": "flex",
        "direction": "column",
        "width": "100%",
        "height": "100%",
        "overflow": "hidden"
      },
      "header": {
        "position": "top",
        "flexShrink": 0
      },
      "content": {
        "flex": 1,
        "minHeight": 0,
        "overflowY": "auto"
      },
      "bottomNav": {
        "position": "bottom",
        "flexShrink": 0
      },
      "standalonePage": {
        "display": "flex",
        "direction": "column",
        "height": "100%",
        "header": {
          "flexShrink": 0
        },
        "content": {
          "flex": 1,
          "minHeight": 0,
          "overflowY": "auto"
        },
        "bottomAction": {
          "flexShrink": 0
        }
      },
      "overlays": {
        "layer": "above-app-shell"
      },
      "safeArea": true
    },
    "primaryColor": "#0F766E",
    "backgroundColor": "#FFFFFF",
    "surfaceColor": "#F8FAFC",
    "borderRadius": "16px",
    "spacing": "8px",
    "mobile": {
      "referenceWidth": 390,
      "minimumWidth": 320,
      "safeArea": true,
      "navigationHeight": "64px"
    }
  }
}
