{
  "blueprint": {
    "name": "Travel & Tours",
    "version": "1.1.0",
    "status": "final-blueprint",
    "source": "blueprint.json",
    "platform": "mobile-only",
    "orientation": "portrait",
    "framework": "React",
    "language": "TypeScript",
    "documentType": "application-specific-blueprint",
    "validationStatus": "blueprint-structure-validated",
    "revision": "1.1.0",
    "previousRevision": "1.0.0"
  },
  "App": {
    "component": "App",
    "root": true,
    "responsibilities": [
      "application-entry",
      "session-state-resolution",
      "route-resolution",
      "layout-selection",
      "overlay-host"
    ],
    "children": [
      "AuthScreen",
      "AppShell",
      "StandalonePages",
      "Overlays"
    ],
    "states": {
      "resolving": {
        "view": "AppLoadingState"
      },
      "authenticated": {
        "view": "AppShell"
      },
      "guest": {
        "view": "AppShell"
      },
      "unauthenticated": {
        "view": "route-driven",
        "defaultView": "AuthScreen",
        "allowedLayouts": [
          "AuthScreen",
          "StandalonePages",
          "NotFoundPage"
        ]
      }
    },
    "guestAccess": {
      "enabled": true,
      "action": "ContinueAsGuest",
      "destination": "AppShell",
      "accessPolicy": "public-routes-only"
    },
    "layoutSelection": {
      "strategy": "route-and-session-driven",
      "precedence": [
        "resolve-session-state",
        "match-current-route",
        "validate-dynamic-route-parameters",
        "enforce-route-access-policy",
        "select-layout-from-route-and-session",
        "render-single-active-page"
      ],
      "rules": {
        "resolving": "AppLoadingState",
        "unauthenticatedDefault": "AuthScreen",
        "unauthenticatedPublicStandaloneRoute": "StandalonePages",
        "authenticatedOrGuestStandaloneRoute": "StandalonePages",
        "authenticatedOrGuestAppShellRoute": "AppShell",
        "deniedRoute": "configured-access-denied-behavior",
        "unknownRoute": "NotFoundPage"
      },
      "authScreen": "default-view-for-unauthenticated-entry",
      "appShell": "for-registered-app-shell-routes-when-session-or-guest-access-is-valid",
      "standalonePages": "for-registered-standalone-routes-when-route-access-is-valid",
      "unknownRoute": "NotFoundPage"
    }
  },
  "AuthScreen": {
    "component": "AuthScreen",
    "layout": "standalone",
    "children": [
      {
        "id": "login",
        "component": "Login",
        "action": "StartAuthentication"
      },
      {
        "id": "guest",
        "component": "Guest",
        "action": "ContinueAsGuest"
      }
    ]
  },
  "AppShell": {
    "component": "AppShell",
    "layout": "vertical",
    "responsibilities": [
      "primary-navigation-layout",
      "shared-page-chrome"
    ],
    "children": [
      {
        "id": "header",
        "component": "Header",
        "position": "top",
        "flexShrink": 0,
        "children": [
          {
            "id": "logo",
            "component": "Logo",
            "action": "NavigateHome"
          },
          {
            "id": "header-actions",
            "component": "HeaderActions",
            "children": [
              {
                "id": "notif-btn",
                "component": "NotifBtn",
                "icon": "bell",
                "action": "NavigateNotificationPage"
              },
              {
                "id": "profile-btn",
                "component": "ProfileBtn",
                "icon": "user-round",
                "action": "NavigateProfilePage"
              }
            ]
          }
        ]
      },
      {
        "id": "content",
        "component": "Content",
        "flex": 1,
        "minHeight": 0,
        "scrollable": true,
        "children": [
          {
            "id": "home-page",
            "component": "HomePage",
            "route": "/",
            "access": "public"
          },
          {
            "id": "explore-page",
            "component": "ExplorePage",
            "route": "/explore",
            "access": "public"
          },
          {
            "id": "livechat-page",
            "component": "LiveChatPage",
            "route": "/live-chat",
            "access": "public"
          },
          {
            "id": "profile-page",
            "component": "ProfilePage",
            "route": "/profile",
            "access": "public"
          },
          {
            "id": "notification-page",
            "component": "NotificationPage",
            "route": "/notifications",
            "access": "public"
          }
        ],
        "renderMode": "single-active-page",
        "activePageSource": "validated-current-route",
        "inactivePageBehavior": "not-rendered-as-active-page"
      },
      {
        "id": "bottom-nav",
        "component": "BottomNav",
        "position": "bottom",
        "flexShrink": 0,
        "visibility": "app-shell-only",
        "items": [
          {
            "id": "home",
            "label": "Home",
            "icon": "house",
            "route": "/"
          },
          {
            "id": "explore",
            "label": "Explore",
            "icon": "compass",
            "route": "/explore"
          },
          {
            "id": "livechat",
            "label": "Live Chat",
            "icon": "message-circle",
            "route": "/live-chat"
          }
        ]
      }
    ]
  },
  "StandalonePages": {
    "component": "StandalonePages",
    "layout": {
      "type": "vertical",
      "slots": [
        {
          "component": "Header",
          "required": false,
          "flexShrink": 0
        },
        {
          "component": "Content",
          "required": true,
          "flex": 1,
          "minHeight": 0,
          "overflowY": "auto"
        },
        {
          "component": "BottomAction",
          "required": false,
          "flexShrink": 0
        }
      ],
      "bottomNav": false,
      "contentOwnership": "page-content-only",
      "bottomActionBehavior": {
        "participatesInLayoutFlow": true,
        "overlaysContent": false,
        "visibility": "page-defined"
      }
    },
    "pages": [
      {
        "id": "destination-detail-page",
        "component": "DestinationDetailPage",
        "route": "/destinations/:destinationId",
        "layout": "StandalonePage",
        "access": "public"
      },
      {
        "id": "tour-detail-page",
        "component": "TourDetailPage",
        "route": "/tours/:tourId",
        "layout": "StandalonePage",
        "access": "public"
      },
      {
        "id": "search-results-page",
        "component": "SearchResultsPage",
        "route": "/search",
        "layout": "StandalonePage",
        "access": "public"
      },
      {
        "id": "booking-page",
        "component": "BookingPage",
        "route": "/booking",
        "layout": "StandalonePage",
        "access": "public"
      },
      {
        "id": "checkout-page",
        "component": "CheckoutPage",
        "route": "/checkout",
        "layout": "StandalonePage",
        "access": "public"
      },
      {
        "id": "booking-confirmation-page",
        "component": "BookingConfirmationPage",
        "route": "/booking/confirmation",
        "layout": "StandalonePage",
        "access": "public"
      },
      {
        "id": "booking-history-page",
        "component": "BookingHistoryPage",
        "route": "/bookings",
        "layout": "StandalonePage",
        "access": "public"
      },
      {
        "id": "booking-detail-page",
        "component": "BookingDetailPage",
        "route": "/bookings/:bookingId",
        "layout": "StandalonePage",
        "access": "public"
      }
    ]
  },
  "Routing": {
    "strategy": "route-based",
    "defaultRoute": "/",
    "defaultPage": "HomePage",
    "unknownRoute": {
      "component": "NotFoundPage",
      "layout": "StandalonePage"
    },
    "dynamicParameters": {
      "enabled": true,
      "validation": "validate-required-route-parameters-before-page-render"
    },
    "navigation": {
      "preserveUrl": true,
      "activeRouteDrivesPage": true,
      "activeRouteDrivesBottomNav": true
    },
    "accessPolicy": {
      "default": "public",
      "allowedValues": [
        "public",
        "guest-allowed",
        "authenticated"
      ],
      "routeDeclaration": "every-registered-route-declares-access",
      "guest": "public-and-guest-allowed-routes-only",
      "protectedRoutes": [],
      "protectedRouteBehavior": "deny-before-layout-render",
      "unauthenticatedBehavior": "show-auth-screen-for-auth-entry-or-default-entry; allow-public-standalone-routes",
      "deniedRouteBehavior": "redirect-to-auth-screen",
      "accessEvaluationOrder": "before-layout-selection-and-page-render"
    },
    "resolutionOrder": [
      "resolve-session-state",
      "match-current-route",
      "validate-dynamic-route-parameters",
      "enforce-route-access-policy",
      "select-page-layout-from-route-and-session",
      "render-exactly-one-active-page"
    ],
    "routeConflictPolicy": "exact-static-routes-before-dynamic-parameter-routes",
    "fallback": {
      "route": "*",
      "component": "NotFoundPage",
      "layout": "StandalonePage",
      "actions": [
        "NavigateHome",
        "GoBack"
      ],
      "access": "public"
    }
  },
  "Navigation": {
    "defaultPage": "HomePage",
    "bottomNavPages": [
      "HomePage",
      "ExplorePage",
      "LiveChatPage"
    ],
    "headerNavigation": {
      "Logo": "HomePage",
      "NotifBtn": "NotificationPage",
      "ProfileBtn": "ProfilePage"
    },
    "standalonePageNavigation": "RouteBased",
    "bottomNavVisibility": {
      "AppShell": true,
      "StandalonePages": false,
      "AuthScreen": false
    }
  },
  "Overlays": {
    "component": "Overlays",
    "host": "App",
    "layer": "above-current-layout",
    "components": [
      {
        "id": "modal",
        "component": "Modal",
        "enabled": true,
        "dismissible": true
      },
      {
        "id": "bottom-sheet",
        "component": "BottomSheet",
        "enabled": true,
        "dismissible": true
      },
      {
        "id": "drawer",
        "component": "Drawer",
        "enabled": true,
        "dismissible": true
      },
      {
        "id": "toast",
        "component": "Toast",
        "enabled": true,
        "dismissible": false,
        "behavior": "temporary-notification"
      }
    ],
    "stateManagement": "centralized",
    "inactiveInteraction": false,
    "accessibility": {
      "modalFocusManagement": true,
      "restoreFocusOnDismiss": true,
      "escapeDismissalWhenSupported": true,
      "announceToastNotifications": true
    }
  },
  "DesignSystem": {
    "style": "Modern Premium Travel",
    "theme": "Light",
    "platform": "mobile-only",
    "orientation": "portrait",
    "tokens": {
      "primaryColor": "#0F766E",
      "backgroundColor": "#FFFFFF",
      "surfaceColor": "#F8FAFC",
      "borderRadius": "16px",
      "spacing": "8px"
    },
    "layout": {
      "appShell": {
        "display": "flex",
        "direction": "column",
        "width": "100%",
        "height": "100%",
        "overflow": "hidden"
      },
      "header": {
        "flexShrink": 0
      },
      "content": {
        "flex": 1,
        "minHeight": 0,
        "overflowY": "auto"
      },
      "bottomNav": {
        "flexShrink": 0,
        "safeAreaAware": false
      },
      "standalonePage": {
        "display": "flex",
        "direction": "column",
        "height": "100%",
        "header": {
          "flexShrink": 0
        },
        "content": {
          "flex": 1,
          "minHeight": 0,
          "overflowY": "auto"
        },
        "bottomAction": {
          "flexShrink": 0,
          "safeAreaAware": false
        }
      },
      "overlays": {
        "layer": "above-current-layout"
      },
      "safeArea": true,
      "safeAreaPolicy": {
        "owner": "application-layout",
        "responsibility": "calculate-and-apply-device-safe-area-insets",
        "applyTo": [
          "Header",
          "BottomNav",
          "BottomAction",
          "edge-aligned-overlays"
        ],
        "childComponents": "consume-layout-provided-insets",
        "prohibitDuplicateInsets": true
      }
    },
    "mobile": {
      "referenceWidth": 390,
      "minimumWidth": 320,
      "navigationHeight": "64px",
      "safeArea": true,
      "horizontalOverflow": false
    }
  },
  "TechnicalStandards": {
    "framework": "React",
    "language": "TypeScript",
    "componentModel": "functional-components",
    "typeSafety": {
      "strict": true,
      "avoidAny": true,
      "documentExceptions": true
    },
    "architecture": {
      "reusableComponents": true,
      "centralizedRouting": true,
      "centralizedLayout": true,
      "centralizedOverlayManagement": true,
      "explicitComponentContracts": true
    },
    "uiStates": [
      "loading",
      "error",
      "empty"
    ],
    "quality": {
      "accessibleInteractiveComponents": true,
      "noBrokenRoutes": true,
      "noHorizontalOverflow": true,
      "productionBuildRequired": true,
      "typecheckRequired": true
    },
    "accessibility": {
      "semanticElements": true,
      "keyboardAndScreenReaderSupport": true,
      "accessibleNamesForIconOnlyControls": true,
      "visibleFocusState": true,
      "modalFocusTrapAndRestore": true
    },
    "validation": {
      "jsonSyntax": "required",
      "routeUniqueness": "required",
      "componentReferenceConsistency": "every-component-reference-must-exist-in-ComponentRegistry.registeredComponents",
      "typescriptStrictTypecheck": "required",
      "productionBuild": "required",
      "routeAccessDeclaration": "required",
      "singleActivePageRendering": "required",
      "safeAreaOwnership": "single-application-layout-owner"
    }
  },
  "Requirements": {
    "baseline": "v1.1.0",
    "items": [
      {
        "id": "F-01",
        "name": "Authentication Architecture",
        "acceptanceCriteria": [
          "App resolves session state before selecting the application view.",
          "Authenticated users enter AppShell.",
          "Guest users enter AppShell with guest access state.",
          "Unauthenticated users can access AuthScreen.",
          "Login and ContinueAsGuest actions are defined.",
          "Guest access is limited to public routes."
        ]
      },
      {
        "id": "F-02",
        "name": "Root Application Architecture",
        "acceptanceCriteria": [
          "App is the single application entry point.",
          "App owns session resolution, route resolution, layout selection, and overlay hosting.",
          "AppShell and StandalonePages are selected without duplicating the root layout.",
          "Overlays are hosted at application level."
        ]
      },
      {
        "id": "F-03",
        "name": "StandalonePages Architecture",
        "acceptanceCriteria": [
          "StandalonePages uses a vertical Header, Content, and BottomAction slot layout.",
          "Content is required and independently scrollable.",
          "Header and BottomAction are optional per page.",
          "BottomAction does not cover Content.",
          "StandalonePages does not render AppShell BottomNav."
        ]
      },
      {
        "id": "F-04",
        "name": "Bottom Navigation Architecture",
        "acceptanceCriteria": [
          "BottomNav is rendered only in AppShell.",
          "BottomNav contains Home, Explore, and Live Chat routes.",
          "Active navigation follows the current route.",
          "BottomNav respects the device safe area."
        ]
      },
      {
        "id": "F-05",
        "name": "Routing Architecture",
        "acceptanceCriteria": [
          "Every defined page has a unique route.",
          "Dynamic route parameters are validated before page rendering.",
          "Unknown routes render NotFoundPage.",
          "Navigation preserves URL and active route state.",
          "Protected routes use an explicit access policy.",
          "Guest users can access public routes."
        ]
      },
      {
        "id": "F-06",
        "name": "Design System and Responsive Layout",
        "acceptanceCriteria": [
          "The application supports portrait mobile viewports from 320px and uses 390px as the reference width.",
          "Header and bottom navigation remain outside the scrolling Content region.",
          "Content scrolls independently.",
          "Safe areas are respected by relevant fixed or edge-aligned controls.",
          "No horizontal overflow occurs at supported viewport widths.",
          "Design tokens are used consistently."
        ]
      },
      {
        "id": "F-07",
        "name": "Overlay Architecture",
        "acceptanceCriteria": [
          "Modal, BottomSheet, Drawer, and Toast are hosted centrally.",
          "Overlays render above the active application layout.",
          "Overlay visibility and state are centrally controlled.",
          "Inactive overlays do not intercept interaction.",
          "Dismissal behavior is defined for interactive overlays."
        ]
      },
      {
        "id": "F-08",
        "name": "Production Technical Architecture",
        "acceptanceCriteria": [
          "Components have explicit and maintainable responsibilities.",
          "Component props use TypeScript types or interfaces.",
          "Any usage is avoided or documented with a technical reason.",
          "Loading, error, and empty states are handled.",
          "Interactive components follow accessibility requirements.",
          "Type checking completes without errors.",
          "Production build completes successfully.",
          "All defined routes are verified."
        ]
      },
      {
        "id": "F-09",
        "name": "Component Registry and System Component Contracts",
        "acceptanceCriteria": [
          "Every component reference in the blueprint exists in ComponentRegistry.registeredComponents.",
          "AppLoadingState has an explicit responsibility and accessibility contract.",
          "NotFoundPage has an explicit layout, recovery actions, and accessibility contract.",
          "Component references are validated against the registry."
        ]
      },
      {
        "id": "F-10",
        "name": "Single Active Page Rendering",
        "acceptanceCriteria": [
          "AppShell.Content renders exactly one active page selected by the validated current route.",
          "Non-active route pages are not rendered as active page content.",
          "The active route remains the source of truth for page and BottomNav selection."
        ]
      },
      {
        "id": "F-11",
        "name": "Deterministic Session and Layout Selection",
        "acceptanceCriteria": [
          "Session resolution completes before access policy and layout selection.",
          "Route classification and access policy determine whether AuthScreen, AppShell, or StandalonePages is selected.",
          "Unauthenticated users default to AuthScreen when entering the application without an eligible public standalone route.",
          "Valid public standalone routes can render without forcing AppShell or AuthScreen.",
          "Unknown routes render NotFoundPage."
        ]
      },
      {
        "id": "F-12",
        "name": "Route-Level Access Policy",
        "acceptanceCriteria": [
          "Every registered route declares an access level.",
          "Supported access levels are public, guest-allowed, and authenticated.",
          "Guest users can access public and guest-allowed routes only.",
          "Access is evaluated before layout selection and page rendering.",
          "Denied protected routes follow the configured authentication redirect behavior."
        ]
      },
      {
        "id": "F-13",
        "name": "Single Safe-Area Ownership",
        "acceptanceCriteria": [
          "Application layout is the single owner of safe-area inset calculation and application.",
          "Header, BottomNav, BottomAction, and edge-aligned overlays consume layout-provided insets.",
          "Child components do not apply duplicate safe-area insets.",
          "Safe-area behavior is consistent across AppShell and StandalonePages."
        ]
      }
    ],
    "previousBaseline": "v1.0.0"
  },
  "Scope": {
    "included": [
      "application-architecture",
      "authentication-screen-structure",
      "guest-entry-flow",
      "app-shell",
      "standalone-page-layout",
      "routing-contract",
      "bottom-navigation",
      "design-system",
      "overlay-architecture",
      "typescript-production-standards",
      "component-registry-and-system-state-contracts",
      "single-active-page-rendering",
      "route-level-access-policy",
      "deterministic-session-layout-selection",
      "centralized-safe-area-ownership"
    ],
    "excluded": [
      "authentication-provider-integration",
      "booking-backend",
      "payment-gateway",
      "database-integration",
      "live-chat-backend",
      "notification-service"
    ],
    "deployment": "requires-separate-approval",
    "merge": "requires-separate-approval"
  },
  "ComponentRegistry": {
    "policy": "every-component-reference-must-exist-in-registeredComponents",
    "registeredComponents": [
      "App",
      "AppLoadingState",
      "AppShell",
      "AuthScreen",
      "BookingConfirmationPage",
      "BookingDetailPage",
      "BookingHistoryPage",
      "BookingPage",
      "BottomAction",
      "BottomNav",
      "BottomSheet",
      "CheckoutPage",
      "Content",
      "DestinationDetailPage",
      "Drawer",
      "ExplorePage",
      "Guest",
      "Header",
      "HeaderActions",
      "HomePage",
      "LiveChatPage",
      "Login",
      "Logo",
      "Modal",
      "NotFoundPage",
      "NotifBtn",
      "NotificationPage",
      "Overlays",
      "ProfileBtn",
      "ProfilePage",
      "SearchResultsPage",
      "StandalonePages",
      "Toast",
      "TourDetailPage"
    ],
    "systemComponentContracts": {
      "AppLoadingState": {
        "responsibility": "present-a-non-interactive-loading-state-while-session-or-initial-route-resolution-is-pending",
        "props": [
          "message?"
        ],
        "accessibility": "expose-loading-status-to-assistive-technology"
      },
      "NotFoundPage": {
        "responsibility": "present-a-recoverable-state-for-unknown-or-unmatched-routes",
        "layout": "StandalonePage",
        "actions": [
          "NavigateHome",
          "GoBack"
        ],
        "accessibility": "provide-a-clear-page-title-and-named-navigation-actions"
      }
    }
  }
}
